+#[cfg(test)]
+mod tests {
+    use algebra::{Field, Goldilocks};
+
+    use super::*;
+
+    const Q: u64 = Goldilocks::MODULUS_VALUE;
+    const TWO_N: u64 = 2048;
+
+    #[test]
+    fn exact_rounding_handles_goldilocks_segment_boundaries() {
+        let values = [
+            0,
+            1,
+            Q / (2 * TWO_N) - 1,
+            Q / (2 * TWO_N),
+            Q / (2 * TWO_N) + 1,
+            Q / 2 - 1,
+            Q / 2,
+            Q - 2,
+            Q - 1,
+        ];
+
+        for value in values {
+            let expected = (((value as u128) * (TWO_N as u128) + (Q as u128 / 2)) / Q as u128
+                % TWO_N as u128) as u64;
+            assert_eq!(
+                modulus_switch_value(value as u128, Q as u128, TWO_N),
+                expected
+            );
+        }
+    }
+
+    #[test]
+    fn traced_and_inplace_variants_match() {
+        let input = LWE::new(
+            vec![
+                Goldilocks::new(0),
+                Goldilocks::new(Q / 2),
+                Goldilocks::new(Q - 1),
+            ],
+            Goldilocks::new(Q / 3),
+        );
+        let expected = lwe_modulus_switch(&input, TWO_N);
+        let (traced, _) = lwe_modulus_switch_w_trace(&input, TWO_N);
+        let mut inplace = LWE::new(vec![0; input.a().len()], 0);
+        lwe_modulus_switch_inplace(input, TWO_N, &mut inplace);
+
+        assert_eq!(traced, expected);
+        assert_eq!(inplace, expected);
+    }
+}
