+#[inline]
+fn modulus_switch_value<T: UnsignedInteger>(
+    value: u128,
+    modulus_before: u128,
+    modulus_after: T,
+) -> T {
+    let modulus_after: u128 = modulus_after.as_into();
+    assert!(modulus_before != 0, "source modulus must be nonzero");
+
+    let numerator = value
+        .checked_mul(modulus_after)
+        .and_then(|product| product.checked_add(modulus_before / 2))
+        .expect("modulus switch intermediate exceeds u128");
+    T::as_from((numerator / modulus_before) % modulus_after)
+}
