index 00000000..a5bab8ef
--- /dev/null
+++ b/uni-stark/src/northstar.rs
@@ -0,0 +1,338 @@
+//! Northstar sumcheck: zero-target sumcheck protocol integrated into the STARK.
+//!
+//! The prover commits to R(X), Q_sc(X), and degree-bound witnesses XR(X), XQ_sc(X).
+//! The latter are constrained to equal X * R(X) and X * Q_sc(X) at the OOD point.
+//! Since FRI bounds every committed polynomial to degree < N, these identities
+//! force R and Q_sc to have degree < N - 1. The main identity at
+//! the OOD point zeta:
+//!
+//!   sum_i rho^(i-1) * [g_i(zeta)*sigma_alpha(zeta) - f_i(zeta)*Lambda'_alpha(zeta)]
+//!       = zeta * R(zeta) + Q_sc(zeta) * (zeta^N - 1)
+//!
+//! The f_i and g_i are trace columns whose openings are already available.
+
+use alloc::vec;
+use alloc::vec::Vec;
+
+use p3_field::{ExtensionField, Field};
+use p3_matrix::dense::RowMajorMatrix;
+use p3_maybe_rayon::prelude::*;
+use serde::{Deserialize, Serialize};
+
+use crate::{StarkGenericConfig, Val};
+
+/// Prover-side data for the Northstar sumcheck.
+///
+/// The caller (VFHE) computes R and Q_sc externally after receiving alpha_sc and rho
+/// from the transcript, then passes this struct to the extended prover.
+pub struct NorthstarProverData<SC: StarkGenericConfig> {
+    /// A base-field matrix [R, Q_sc, XR, XQ_sc] evaluated on the trace domain.
+    /// Extension-field values are flattened into base-field columns.
+    pub rq_trace: RowMajorMatrix<Val<SC>>,
+}
+
+/// Verifier-side specification for the Northstar sumcheck (stacked approach).
+///
+/// Tells the verifier which trace columns are f_tilde and g_tilde, and provides
+/// the domain parameters needed to evaluate the stacked sigma'_alpha and Lambda'_alpha.
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct NorthstarVerifierData {
+    /// Column indices in the main trace for the coefficient-domain polynomials (decomp_a).
+    pub f_col_indices: Vec<usize>,
+    /// Column indices in the main trace for the NTT-domain polynomials (decomp_a_ntt).
+    pub g_col_indices: Vec<usize>,
+    /// log2(N) where N is the per-block NTT size (e.g., 10 for N=1024).
+    pub log_n: usize,
+    /// Number of blocks (k). Total trace domain = k*N.
+    pub num_blocks: usize,
+    /// psi: the 2N-th root of unity for the per-block negacyclic NTT.
+    /// Stored as a raw u64 for the base field element.
+    pub psi_raw: u64,
+    /// omega_kn: the kN-th root of unity (full trace domain generator).
+    /// Stored as a raw u64 for the base field element.
+    pub omega_kn_raw: u64,
+}
+
+/// Precomputed domain data for the Northstar verifier.
+///
+/// Contains O(kN) base-field values that depend only on the domain parameters
+/// (`psi`, `omega_kn`, `n_block`, `num_blocks`) and NOT on verifier challenges.
+/// Construct once via [`NorthstarVerifierData::precompute`] and reuse across
+/// verifier invocations to keep the hot path free of domain arithmetic.
+pub struct NorthstarPrecomputed<F: Field> {
+    /// omega_kn^t for t in 0..kN (full trace-domain powers).
+    pub omega_powers: Vec<F>,
+    /// psi * omega_N^j for j in 0..N (negacyclic coset points).
+    pub coset_points: Vec<F>,
+    /// Per-block NTT size N.
+    pub n_block: usize,
+    /// Number of blocks k.
+    pub num_blocks: usize,
+    /// Column indices for f (coefficient-domain polynomials).
+    pub f_col_indices: Vec<usize>,
+    /// Column indices for g (NTT-domain polynomials).
+    pub g_col_indices: Vec<usize>,
+}
+
+fn shifted_degree_bounds_hold<F: Field>(
+    zeta: F,
+    r_zeta: F,
+    q_sc_zeta: F,
+    xr_zeta: F,
+    xq_sc_zeta: F,
+) -> bool {
+    xr_zeta == zeta * r_zeta && xq_sc_zeta == zeta * q_sc_zeta
+}
+
+impl NorthstarVerifierData {
+    /// Precompute domain tables that are independent of verifier challenges.
+    ///
+    /// For kN-th roots of unity $x_t = \omega_{kN}^t$, the barycentric weight is:
+    /// $$w_t = \frac{1}{\prod_{j \neq t}(x_t - x_j)} = \frac{\omega_{kN}^t}{kN}$$
+    ///
+    /// The Lagrange basis at evaluation point $z$ is then:
+    /// $$L_t(z) = \ell(z) \cdot \frac{w_t}{z - x_t} = \frac{z^{kN}-1}{kN} \cdot \frac{\omega_{kN}^t}{z - \omega_{kN}^t}$$
+    ///
+    /// We store `omega_powers[t]` = $\omega_{kN}^t$ (the numerator of $w_t$ up to
+    /// the shared $1/(kN)$ factor, which is applied once as a scalar in the verifier).
+    ///
+    /// For the negacyclic coset $c_j = \psi \omega_N^j$ (where $\psi^{2N}=1$,
+    /// $\psi^N = -1$), the barycentric weight is:
+    /// $$w_j = \frac{1}{\prod_{k \neq j}(c_j - c_k)} = \frac{-1}{N \cdot c_j}$$
+    /// equivalently $-c_j / N$ after noting $c_j^N = -1$ so $c_j^{N-1} = -c_j^{-1}$.
+    ///
+    /// We store `coset_points[j]` = $c_j = \psi \omega_N^j$, from which $w_j = -c_j/N$.
+    pub fn precompute<F: Field>(&self) -> NorthstarPrecomputed<F> {
+        let n_block = 1usize << self.log_n;
+        let kn = self.num_blocks * n_block;
+        let psi = F::from_u64(self.psi_raw);
+        let omega_kn = F::from_u64(self.omega_kn_raw);
+        let omega_n = psi * psi; // N-th root of unity
+
+        // omega_kn^t for t in 0..kN
+        let mut omega_powers: Vec<F> = Vec::with_capacity(kn);
+        let mut omega_power = F::ONE;
+        for _t in 0..kn {
+            omega_powers.push(omega_power);
+            omega_power *= omega_kn;
+        }
+
+        // psi * omega_N^j for j in 0..N
+        let mut coset_points: Vec<F> = Vec::with_capacity(n_block);
+        let mut omega_n_pow = F::ONE;
+        for _j in 0..n_block {
+            coset_points.push(psi * omega_n_pow);
+            omega_n_pow *= omega_n;
+        }
+
+        NorthstarPrecomputed {
+            omega_powers,
+            coset_points,
+            n_block,
+            num_blocks: self.num_blocks,
+            f_col_indices: self.f_col_indices.clone(),
+            g_col_indices: self.g_col_indices.clone(),
+        }
+    }
+}
+
+/// Verify the Northstar stacked identity at point zeta.
+///
+/// Checks:
+///   sum_l rho^l * [f_l(zeta)*sigma'(zeta) - g_l(zeta)*Lambda'(zeta)]
+///       == zeta * R(zeta) + Q_sc(zeta) * (zeta^{kN} - 1)
+///
+/// sigma'(z) and Lambda'(z) are evaluated via O(kN) Lagrange interpolation
+/// with batch inversion (Montgomery's trick) for efficiency.
+///
+/// The `precomputed` argument holds domain tables (omega powers, coset points)
+/// that are independent of verifier challenges and can be built once via
+/// [`NorthstarVerifierData::precompute`].
+pub fn verify_northstar_identity<F: Field, EF: ExtensionField<F>>(
+    trace_local: &[EF],
+    alpha_sc: EF,
+    eta: EF,
+    rho: EF,
+    zeta: EF,
+    precomputed: &NorthstarPrecomputed<F>,
+    r_zeta: EF,
+    q_sc_zeta: EF,
+    xr_zeta: EF,
+    xq_sc_zeta: EF,
+) -> bool {
+    let f_col_indices = &precomputed.f_col_indices;
+    let g_col_indices = &precomputed.g_col_indices;
+    assert_eq!(f_col_indices.len(), g_col_indices.len());
+    let m = f_col_indices.len();
+    let n_block = precomputed.n_block;
+    let num_blocks = precomputed.num_blocks;
+    let kn = num_blocks * n_block;
+
+    let kn_field = EF::from_u64(kn as u64);
+    let n_field = EF::from_u64(n_block as u64);
+    let z_kn = zeta.exp_u64(kn as u64);
+    let vanishing_kn = z_kn - EF::ONE;
+    let alpha_n = alpha_sc.exp_u64(n_block as u64);
+    let one_plus_alpha_n = EF::ONE + alpha_n;
+
+    // Compute Lagrange coset values: L_{psi*omega_N^j}(alpha_sc)
+    // using precomputed coset points and batch inversion (Montgomery's trick).
+    let coset_diffs: Vec<EF> = (0..n_block)
+        .map(|j| {
+            let psi_omega_j: EF = precomputed.coset_points[j].into();
+            n_field * (alpha_sc - psi_omega_j)
+        })
+        .collect();
+
+    // Batch-invert all N coset denominators with a single inversion.
+    let mut coset_prefix: Vec<EF> = Vec::with_capacity(n_block);
+    coset_prefix.push(coset_diffs[0]);
+    for j in 1..n_block {
+        coset_prefix.push(coset_prefix[j - 1] * coset_diffs[j]);
+    }
+    let mut coset_inv_suffix = coset_prefix[n_block - 1].inverse();
+    let mut inv_coset_diffs: Vec<EF> = vec![EF::ZERO; n_block];
+    for j in (1..n_block).rev() {
+        inv_coset_diffs[j] = coset_inv_suffix * coset_prefix[j - 1];
+        coset_inv_suffix *= coset_diffs[j];
+    }
+    inv_coset_diffs[0] = coset_inv_suffix;
+
+    let lagrange_coset: Vec<EF> = (0..n_block)
+        .map(|j| {
+            let psi_omega_j: EF = precomputed.coset_points[j].into();
+            -psi_omega_j * one_plus_alpha_n * inv_coset_diffs[j]
+        })
+        .collect();
+
+    // --- Parallel batch inversion (divide-and-conquer) for all kN denominators ---
+    // Compute diffs[t] = zeta - omega_kn^t using precomputed omega_powers.
+    let omega_powers = &precomputed.omega_powers;
+
+    let diffs: Vec<EF> = omega_powers
+        .par_iter()
+        .map(|&w| zeta - EF::from(w))
+        .collect();
+
+    // Divide kN elements into chunks. Each chunk is batch-inverted independently
+    // (1 inversion + O(chunk_size) muls per chunk), and all chunks run in parallel.
+    // Total work: O(kN) muls + num_chunks inversions.
+    // With num_blocks chunks of size n_block, we get num_blocks inversions
+    // (one per block) but the sequential path within each chunk is only O(N).
+    let chunk_size = n_block; // one chunk per block
+    let inv_diffs: Vec<EF> = diffs
+        .par_chunks(chunk_size)
+        .flat_map_iter(|chunk| {
+            let len = chunk.len();
+            // Montgomery's trick within this chunk
+            let mut prefix = Vec::with_capacity(len);
+            prefix.push(chunk[0]);
+            for i in 1..len {
+                prefix.push(prefix[i - 1] * chunk[i]);
+            }
+            let mut inv_suffix = prefix[len - 1].inverse();
+            let mut inv_chunk = vec![EF::ZERO; len];
+            for i in (1..len).rev() {
+                inv_chunk[i] = inv_suffix * prefix[i - 1];
+                inv_suffix *= chunk[i];
+            }
+            inv_chunk[0] = inv_suffix;
+            inv_chunk
+        })
+        .collect();
+
+    // --- Parallel accumulation of sigma'(zeta) and Lambda'(zeta) ---
+    // Each block i contributes independently; reduce partial sums via par_iter.
+    // Pre-compute eta_powers[i] = eta^i and alpha_powers[j] = alpha_sc^j.
+    let mut alpha_powers: Vec<EF> = Vec::with_capacity(n_block);
+    let mut ap = EF::ONE;
+    for _j in 0..n_block {
+        alpha_powers.push(ap);
+        ap *= alpha_sc;
+    }
+
+    let mut eta_powers: Vec<EF> = Vec::with_capacity(num_blocks);
+    let mut ep = EF::ONE;
+    for _i in 0..num_blocks {
+        eta_powers.push(ep);
+        ep *= eta;
+    }
+
+    let block_sums: Vec<(EF, EF)> = (0..num_blocks)
+        .into_par_iter()
+        .map(|i| {
+            let base_t = i * n_block;
+            let eta_i = eta_powers[i];
+            let mut s = EF::ZERO;
+            let mut l = EF::ZERO;
+            for j in 0..n_block {
+                let t = base_t + j;
+                let omega_m: EF = omega_powers[t].into();
+                let basis_contrib = omega_m * inv_diffs[t];
+                s += eta_i * alpha_powers[j] * basis_contrib;
+                l += eta_i * lagrange_coset[j] * basis_contrib;
+            }
+            (s, l)
+        })
+        .collect();
+    let (sigma_z, lambda_z) = block_sums
+        .into_iter()
+        .fold((EF::ZERO, EF::ZERO), |(s1, l1), (s2, l2)| {
+            (s1 + s2, l1 + l2)
+        });
+
+    // Multiply by (z^{kN} - 1) / (kN)
+    let scale = vanishing_kn * kn_field.inverse();
+    let sigma_z = sigma_z * scale;
+    let lambda_z = lambda_z * scale;
+
+    // Compute LHS: sum_l rho^l * [f_l(zeta)*sigma'(zeta) - g_l(zeta)*Lambda'(zeta)]
+    let mut lhs = EF::ZERO;
+    let mut rho_power = EF::ONE;
+    for l in 0..m {
+        let f_zeta = trace_local[f_col_indices[l]];
+        let g_zeta = trace_local[g_col_indices[l]];
+        lhs += rho_power * (f_zeta * sigma_z - g_zeta * lambda_z);
+        rho_power *= rho;
+    }
+
+    // RHS: zeta * R(zeta) + Q_sc(zeta) * (zeta^{kN} - 1)
+    let rhs = zeta * r_zeta + q_sc_zeta * vanishing_kn;
+
+    lhs == rhs && shifted_degree_bounds_hold(zeta, r_zeta, q_sc_zeta, xr_zeta, xq_sc_zeta)
+}
+
+#[cfg(test)]
+mod tests {
+    use p3_baby_bear::BabyBear;
+    use p3_field::PrimeCharacteristicRing;
+
+    use super::shifted_degree_bounds_hold;
+
+    #[test]
+    fn shifted_degree_bounds_reject_incorrect_r_or_q_witness() {
+        let zeta = BabyBear::from_u64(2);
+        let r_zeta = BabyBear::from_u64(3);
+        let q_sc_zeta = BabyBear::from_u64(5);
+        let xr_zeta = zeta * r_zeta;
+        let xq_sc_zeta = zeta * q_sc_zeta;
+
+        assert!(shifted_degree_bounds_hold(
+            zeta, r_zeta, q_sc_zeta, xr_zeta, xq_sc_zeta,
+        ));
+        assert!(!shifted_degree_bounds_hold(
+            zeta,
+            r_zeta,
+            q_sc_zeta,
+            xr_zeta + BabyBear::ONE,
+            xq_sc_zeta,
+        ));
+        assert!(!shifted_degree_bounds_hold(
+            zeta,
+            r_zeta,
+            q_sc_zeta,
+            xr_zeta,
+            xq_sc_zeta + BabyBear::ONE,
+        ));
+    }
+}
